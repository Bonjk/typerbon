rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 文章
    match /articles/{id} {
      allow read, write: if true;
    }

    // 學生練習紀錄（允許新增與刪除，刪除由教師後台執行）
    match /records/{studentId}/sessions/{sessionId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
    }

    // 排行榜（含考試成績，以 exam_ 前綴區分）
    match /leaderboard/{id} {
      allow read, write: if true;
    }

    // 系統設定（教師密碼、進行中考試、seed 版本）
    match /settings/{doc} {
      allow read, write: if true;
    }

    // 考試記錄（考試結束時自動寫入）
    match /examRecords/{id} {
      allow read, write: if true;
    }

    // 學生個人資料（成就、主題偏好、字型大小）
    match /students/{id} {
      allow read, write: if true;
    }

  }
}
